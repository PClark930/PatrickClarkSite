---
title: ""
layout: layouts/base.njk
fullBleed: true
---
{#- Home page: a charcoal banner with the intro, then highlights (src/_data/highlights.json)
    and recognition (resume.json's honors). #}
<section class="band" aria-labelledby="intro-name">
  <div class="wrap band-inner">
    <h1 id="intro-name">{{ site.name }}</h1>
    {%- if resume.headline %}
    <p class="band-headline">{{ resume.headline }}</p>
    {%- endif %}
    {%- if resume.summary %}
    <p class="band-summary">{{ resume.summary }}</p>
    {%- endif %}
    <div class="actions">
      <a class="button button-light" href="/resume/">View resume</a>
      {#- The PDF is printed by `npm run build`, so this link is missing under `npm start`. #}
      {%- if resume.experience.length %}
      <a class="button button-ghost" href="/{{ resumeVersions[0].file }}.pdf">Download PDF</a>
      {%- endif %}
    </div>
    {%- if resume.location or resume.email or resume.links.length %}
    <p class="band-links">
      {%- if resume.location %}<span>{{ resume.location }}</span>{% endif %}
      {%- if resume.email %}<a href="mailto:{{ resume.email }}">{{ resume.email }}</a>{% endif %}
      {%- for l in resume.links %}<a href="{{ l.url }}">{{ l.label }}</a>{% endfor %}
    </p>
    {%- endif %}
  </div>
</section>

{%- if highlights.stats.length %}
<div class="tint-band">
<section class="wrap" aria-labelledby="highlights">
  <h2 id="highlights">Highlights</h2>
  <ul class="stats">
    {%- for s in highlights.stats %}
    <li class="stat">
      <span class="stat-tag">
        <span class="chip chip-sm" aria-hidden="true">
          {%- if s.tag == "Army Reserve" %}
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v5.5c0 4.6 3.1 8.2 7.5 9.5 4.4-1.3 7.5-4.9 7.5-9.5V6z"/></svg>
          {%- else %}
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 20.5h17"/><path d="M5.5 20.5V10L12 5.5l6.5 4.5v10.5"/><path d="M9.5 20.5v-5h5v5"/></svg>
          {%- endif %}
        </span>
        {{ s.tag }}
      </span>
      <span class="stat-figure">{{ s.figure }}</span>
      <span class="stat-label">{{ s.label }}</span>
    </li>
    {%- endfor %}
  </ul>
</section>
</div>
{%- endif %}

{%- if resume.education.length %}
<section class="wrap home-section" aria-labelledby="education">
  <h2 id="education">Education and training</h2>
  <div class="edu-cards">
    {%- for group in [["civilian", "Civilian"], ["military", "Military"]] %}
    {%- set schools = resume.education | byKind(group[0]) %}
    {%- if schools.length %}
    <div class="edu-card">
      <p class="edu-card-head">
        <span class="chip" aria-hidden="true">
          {%- if group[0] == "military" %}
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v5.5c0 4.6 3.1 8.2 7.5 9.5 4.4-1.3 7.5-4.9 7.5-9.5V6z"/><path d="m12 8 1.2 2.5 2.8.4-2 1.9.5 2.7L12 14.2l-2.5 1.3.5-2.7-2-1.9 2.8-.4z"/></svg>
          {%- else %}
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 9 12 4.5 21.5 9 12 13.5z"/><path d="M6.5 11v4.5c0 1.4 2.5 2.8 5.5 2.8s5.5-1.4 5.5-2.8V11"/><path d="M21.5 9v5"/></svg>
          {%- endif %}
        </span>
        {{ group[1] }}
      </p>
      <ul>
        {%- for e in schools %}
        <li><span class="edu-credential">{{ e.credential }}</span><span class="edu-school">{{ e.school }}{% if e.end %} · {{ e.end | monthYear }}{% endif %}</span></li>
        {%- endfor %}
      </ul>
    </div>
    {%- endif %}
    {%- endfor %}
  </div>
</section>
{%- endif %}

{%- if resume.honors.length %}
<section class="wrap home-section" aria-labelledby="recognition">
  <h2 id="recognition">Recognition</h2>
  <ul class="honors">
    {%- for h in resume.honors %}
    <li class="honor">
      <span class="chip" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="9" r="6"/><path d="M8.5 13.9 7 22l5-3 5 3-1.5-8.1"/></svg></span>
      <div>
        <p class="honor-name">{{ h.name }}</p>
        <p class="honor-meta">{{ h.issuer }}{% if h.date %} · {{ h.date | monthYear }}{% endif %}</p>
        {%- if h.detail %}<p class="honor-detail">{{ h.detail }}</p>{% endif %}
      </div>
    </li>
    {%- endfor %}
  </ul>
  <p class="home-more"><a href="/resume/">See the full resume</a></p>
</section>
{%- endif %}
