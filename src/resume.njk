---
title: Resume
description: "Resume of Patrick Clark, Army Reserve Captain: experience, civilian and military education, certifications, and honors."
layout: layouts/base.njk
permalink: /resume/
---
{# Built entirely from src/_data/resume.json. Empty sections don't render. #}
{%- set r = resume %}
<article class="resume">
  <header>
    <h1>{{ site.name }}</h1>
    {%- if r.headline %}<p class="lede">{{ r.headline }}</p>{% endif %}
    {%- if r.location or r.email or r.links.length %}
    <p class="contact">
      {%- if r.location %}<span>{{ r.location }}</span>{% endif %}
      {%- if r.email %}<a href="mailto:{{ r.email }}">{{ r.email }}</a>{% endif %}
      {%- for l in r.links %}<a href="{{ l.url }}">{{ l.label }}</a>{% endfor %}
    </p>
    {%- endif %}
    {#- Printed by scripts/resume-pdf.js in `npm run build`, so it's missing under `npm start`. #}
    {%- if r.experience.length %}
    <p class="pdf-link"><a href="/{{ resumeVersions[0].file }}.pdf">Download PDF</a></p>
    {%- endif %}
  </header>

  {%- if not (r.summary or r.experience.length or r.education.length) %}
  <p>The resume isn't up yet.</p>
  {%- endif %}

  {%- if r.summary %}
  <section><h2>Summary</h2><p>{{ r.summary }}</p></section>
  {%- endif %}

  {%- if r.experience.length %}
  <section class="experience">
    <h2>Experience</h2>
    {%- for job in r.experience %}
    <div class="entry">
      <h3>{{ job.title }}{% if job.company %}, {{ job.company }}{% endif %}</h3>
      <p class="meta">{{ job.start | monthYear }} – {{ job.end | monthYear }}{% if job.location %} · {{ job.location }}{% endif %}</p>
      {%- if job.highlights.length %}
      <ul>{% for h in job.highlights %}<li>{{ h }}</li>{% endfor %}</ul>
      {%- endif %}
    </div>
    {%- endfor %}
  </section>
  {%- endif %}

  {%- if r.education.length %}
  <section>
    <h2>Education and training</h2>
    {#- Grouped by kind ("civilian", "military"); a school without one is listed last. #}
    {%- for group in [["civilian", "Civilian"], ["military", "Military"], ["", ""]] %}
    {%- set schools = r.education | byKind(group[0]) %}
    {%- if schools.length %}
    {%- if group[1] %}<p class="edu-group">{{ group[1] }}</p>{% endif %}
    {%- for e in schools %}
    <div class="entry">
      <h3>{{ e.credential }}{% if e.school %}, {{ e.school }}{% endif %}</h3>
      {%- if e.end %}<p class="meta">{{ e.end | monthYear }}</p>{% endif %}
    </div>
    {%- endfor %}
    {%- endif %}
    {%- endfor %}
  </section>
  {%- endif %}

  {%- if r.certifications.length %}
  <section>
    <h2>Certifications</h2>
    <ul>
      {%- for c in r.certifications %}
      <li>{{ c.name }}{% if c.issuer %}, {{ c.issuer }}{% endif %}{% if c.date %} ({{ c.date | monthYear }}){% endif %}</li>
      {%- endfor %}
    </ul>
  </section>
  {%- endif %}

  {%- if r.honors.length %}
  <section>
    <h2>Honors and Awards</h2>
    <ul>
      {%- for h in r.honors %}
      <li>{{ h.name }}{% if h.issuer %}, {{ h.issuer }}{% endif %}{% if h.date %} ({{ h.date | monthYear }}){% endif %}{% if h.detail %}: {{ h.detail }}{% endif %}</li>
      {%- endfor %}
    </ul>
  </section>
  {%- endif %}

  {%- if r.skills.length %}
  <section>
    <h2>Skills</h2>
    {%- for s in r.skills %}
    <p><strong>{{ s.group }}:</strong> {{ s.items | join(", ") }}</p>
    {%- endfor %}
  </section>
  {%- endif %}
</article>
