<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
    <meta name="description" content="{{ description or site.description }}">
    {#- Link previews (texts, chats, LinkedIn, Facebook, X). The picture is made from
        scripts/og-card.html; addresses must be full https:// ones. #}
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:title" content="{% if title %}{{ title }} · {% endif %}{{ site.name }}">
    <meta property="og:description" content="{{ description or site.description }}">
    <meta property="og:image" content="{{ site.url }}/assets/img/og-card.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Patrick Clark: Army Reserve Captain, operations, logistics and program management, Leavenworth, Kansas">
    <meta name="twitter:card" content="summary_large_image">
    {#- The 404 page is served at whatever address was asked for, so it gets no
        canonical address. #}
    {%- if page.url != "/404.html" %}
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    {%- endif %}
    {#- Kept out of search engines until the site is real. Set "preview": false
        in src/_data/site.json at launch. #}
    {%- if site.preview %}
    <meta name="robots" content="noindex">
    {%- endif %}
    {#- Site icon: the PC shield. The master is icon.svg; scripts/make-icons.js makes the rest. #}
    <link rel="icon" href="{{ '/assets/img/icon.svg' | bust }}" type="image/svg+xml">
    <link rel="icon" href="{{ '/assets/img/icon-32.png' | bust }}" sizes="32x32" type="image/png">
    <link rel="icon" href="{{ '/assets/img/icon-192.png' | bust }}" sizes="192x192" type="image/png">
    <link rel="apple-touch-icon" href="{{ '/assets/img/apple-touch-icon.png' | bust }}">
    <meta name="theme-color" content="#2b3035">
    <link rel="stylesheet" href="{{ '/assets/css/style.css' | bust }}">
</head>
<body>
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/">{{ site.name }}</a>
    <nav aria-label="Main">
      <a href="/resume/"{% if page.url == "/resume/" %} aria-current="page"{% endif %}>Resume</a>
    </nav>
  </div>
</header>
{#- fullBleed pages (the home page) lay out their own bands edge to edge. #}
<main{% if fullBleed %} class="full-bleed"{% else %} class="wrap"{% endif %}>
{{ content | safe }}
</main>
<footer class="site-footer">
  <div class="wrap">
    <span>{{ site.name }}{% if resume.location %} · {{ resume.location }}{% endif %}</span>
    <span>
      {%- if resume.email %}<a href="mailto:{{ resume.email }}">{{ resume.email }}</a> · {% endif %}
      {%- for l in resume.links %}<a href="{{ l.url }}">{{ l.label }}</a> · {% endfor -%}
      <a href="/privacy/"{% if page.url == "/privacy/" %} aria-current="page"{% endif %}>Privacy and disclaimer</a>
    </span>
  </div>
</footer>
</body>
</html>
